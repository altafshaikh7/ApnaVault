# Server Configuration
NODE_ENV=development
PORT=5000

# Client & Frontend URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/apnavault

# Session & Security
# Generate a secure 32+ character random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET=apnavault_development_session_secret_min_32_characters_long
SESSION_COOKIE_NAME=apnavault_session
SESSION_EXPIRES_IN_DAYS=7
VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=15
RESET_RATE_LIMIT_MAX=5

# Email Provider Configuration ('none' | 'resend' | 'smtp')
# Set to 'resend' and supply RESEND_API_KEY for real email delivery
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=ApnaVault <noreply@apnavault.in>
